# Copy to .env and fill in. Never commit .env or paste these values into a chat.
# Sandbox credentials from Unleashed > Integration > Unleashed API Access (account owner only).
# Unleashed keys can't be regenerated, so never paste the LIVE key into a chat.
UNLEASHED_API_ID=
UNLEASHED_API_KEY=
UNLEASHED_BASE_URL=https://api.unleashedsoftware.com
UNLEASHED_CLIENT_TYPE=clearchoice/b2bportal

# Confirmed in the sandbox on 25 Nov 2026: DiscountRate 0.02 = 2%, so "fraction".
UNLEASHED_DISCOUNT_RATE_FORMAT=fraction

# Where the standalone sync script keeps its snapshot (the Shopify app will use Postgres).
SNAPSHOT_PATH=data/unleashed-snapshot.json
