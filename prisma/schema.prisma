// Postgres (Render). Shopify sessions + synced Unleashed pricing data.
// The app and the sync cron read/write pricing through PrismaStore (src/sync/prismaStore.ts).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Shopify app sessions (@shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model UnleashedProduct {
  code             String    @id // Unleashed ProductCode = Shopify variant SKU
  description      String?
  groupName        String?
  defaultSellPrice Decimal?  @db.Decimal(14, 4)
  /// Index 0 = Tier 1. Postgres arrays can't hold nulls through Prisma, so 0 = blank in Unleashed.
  tierPrices       Decimal[] @db.Decimal(14, 4)
  taxable          Boolean   @default(true)
  obsolete         Boolean   @default(false)
  sellable         Boolean   @default(true)
  syncedAt         DateTime  @updatedAt

  @@index([groupName])
}

model UnleashedCustomer {
  code     String   @id // Unleashed CustomerCode (exact, spaces kept)
  name     String?
  tier     Int?
  discount Decimal  @default(0) @db.Decimal(7, 6) // fraction, 0.05 = 5%
  obsolete Boolean  @default(false)
  syncedAt DateTime @updatedAt
}

model CustomerPriceRule {
  id                     String   @id // Unleashed ProductPrice Guid
  customerCode           String
  productCode            String?
  groupName              String?
  type                   String // "fixed" | "discount"
  value                  Decimal  @db.Decimal(14, 4)
  unleashedCustomerPrice Decimal? @db.Decimal(14, 4)
  minQty                 Decimal  @default(0) @db.Decimal(14, 4)
  validFrom              String? // YYYY-MM-DD, Sydney
  validTo                String?
  syncedAt               DateTime @updatedAt

  @@index([customerCode])
}

model ProductQuantityPrice {
  id             String   @id // Unleashed ProductPrice Guid
  productCode    String
  type           String // "fixed" | "discount"
  value          Decimal  @db.Decimal(14, 4)
  unleashedPrice Decimal? @db.Decimal(14, 4)
  minQty         Decimal  @default(0) @db.Decimal(14, 4)
  validFrom      String?
  validTo        String?
  syncedAt       DateTime @updatedAt

  @@index([productCode])
}

model SyncState {
  id               Int       @id @default(1)
  lastFullSyncAt   DateTime?
  lastChangeSyncAt DateTime?
  lastError        String?
}

// Trade orders placed through the portal. id = the Unleashed SalesOrder Guid, saved before sending.
model TradeOrder {
  id                   String   @id
  shop                 String
  requestKey           String // from the order form; stops double submits
  customerId           String
  buyerName            String
  buyerEmail           String?
  companyId            String
  companyName          String    @default("")
  locationId           String
  siteName             String
  customerCode         String // exact Unleashed customer code
  poNumber             String
  note                 String?
  goodsExGst           Decimal  @db.Decimal(14, 2)
  lines                Json
  draftOrderId         String?
  draftOrderName       String?
  status               String // pending | sent | failed | awaiting-approval | rejected
  unleashedOrderNumber String?
  payload              Json? // the Unleashed sales order as sent (prices locked when placed)
  attempts             Int      @default(0)
  lastError            String?
  budgetExGst          Decimal?  @db.Decimal(14, 2) // site budget for the month when placed
  committedBeforeExGst Decimal?  @db.Decimal(14, 2) // already ordered that month, before this order
  approverName         String?
  approverEmail        String?
  decidedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shop, requestKey])
  @@index([locationId, createdAt])
  @@index([companyId, createdAt])
  @@index([status])
}

// Site budgets: goods ex GST per Sydney calendar month. month = "default" (every month) or "YYYY-MM"
// (that month only, overrides the default). No row = no limit.
model SiteBudget {
  id          String   @id @default(cuid())
  shop        String
  companyId   String
  locationId  String
  siteName    String
  month       String
  amountExGst Decimal  @db.Decimal(14, 2)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@unique([shop, locationId, month])
  @@index([shop, companyId])
}

// Delivery sites switched off in the portal (obsolete in Unleashed, or closed by the customer/staff),
// and each site's last order date (for "dormant": no order in 6 months). Mirrors the location
// metafield b2b.closed, which the storefront and buyer checks read.
model SiteStatus {
  id          String    @id @default(cuid())
  shop        String
  companyId   String
  locationId  String
  siteName    String
  closed      Boolean   @default(false)
  source      String? // unleashed | customer | staff
  reason      String?
  closedAt    DateTime?
  closedBy    String?
  lastOrderAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([shop, locationId])
  @@index([shop, companyId])
}
