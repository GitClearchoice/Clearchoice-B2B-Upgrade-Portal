{
  "name": "clearchoice-b2b-portal",
  "version": "0.2.0",
  "private": true,
  "description": "Clearchoice B2B portal: Shopify app (React Router) + Unleashed client, price sync and pricing engine",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "env": "shopify app env",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "sync": "node --env-file-if-exists=.env scripts/sync.ts",
    "sync:changes": "node --env-file-if-exists=.env scripts/sync.ts --changes",
    "sandbox:check": "node --env-file=.env scripts/sandbox-check.ts",
    "price": "node --env-file-if-exists=.env scripts/price.ts",
    "trade:candidates": "node --env-file=.env scripts/trade-candidates.ts",
    "import:companies": "node --env-file=.env scripts/import-companies.ts",
    "order:test": "node --env-file=.env scripts/test-unleashed-order.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "@shopify/ui-extensions": "^2026.1.5",
    "isbot": "^5.1.31",
    "pdfkit": "^0.17.2",
    "preact": "^10.29.8",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/cli": "^3.80.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  }
}
