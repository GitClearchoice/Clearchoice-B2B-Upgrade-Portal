{%- comment -%}
  Cart page: trade prices for every line, PO number, delivery note and "Place order".
  The order goes to the app (/apps/b2b/orders), which prices it again on the server.
{%- endcomment -%}
{%- if customer and customer.b2b? -%}
  {%- comment -%} Company setting "we don't use purchase orders" (saved on the company, stays until unticked). {%- endcomment -%}
  {%- assign no_po = false -%}
  {%- if customer.current_company.metafields.b2b.po_not_required.value == true -%}{%- assign no_po = true -%}{%- endif -%}
  <div
    class="cc-trade-order"
    data-cc-trade-order
    data-proxy="/apps/b2b"
    data-location="{{ customer.current_location.id }}"
    data-po-required="{% if block.settings.po_required and no_po == false %}true{% else %}false{% endif %}"
    data-buyer-name="{{ customer.first_name | append: ' ' | append: customer.last_name | strip | escape }}"
    {{ block.shopify_attributes }}
  >
    <h2 class="cc-trade-order__heading">{{ block.settings.heading }}</h2>
    {%- if customer.company_available_locations_count > 1 -%}
      {%- comment -%}
        Buyers who look after several sites pick the delivery site here (with a search box when
        there are many). Shopify's own url_to_set_as_current switches the buyer's current
        location; the page then reloads and the cart is priced again for that site.
      {%- endcomment -%}
      <div class="cc-site-picker" data-cc-site-picker>
        <div class="cc-site-picker__label">Delivering to</div>
        <button type="button" class="cc-site-picker__current" data-cc-site-toggle aria-expanded="false">
          <strong>{{ customer.current_location.name }}</strong>
          <span class="cc-site-picker__change">Change site</span>
        </button>
        <div class="cc-site-picker__panel" data-cc-site-panel hidden>
          {%- if customer.company_available_locations_count > 5 -%}
            <input
              type="search"
              class="cc-site-picker__search"
              placeholder="Search sites by name or suburb"
              aria-label="Search sites"
              autocomplete="off"
              data-cc-site-search
            >
          {%- endif -%}
          <ul class="cc-site-picker__list" data-cc-site-list>
            {%- for loc in customer.company_available_locations -%}
              {%- comment -%} Closed sites (obsolete in Unleashed, or closed by the customer) aren't offered. {%- endcomment -%}
              {%- if loc.metafields.b2b.closed.value == true and loc.id != customer.current_location.id -%}{%- continue -%}{%- endif -%}
              {%- assign addr = loc.shipping_address -%}
              {%- capture where -%}{{ addr.address1 }}{% if addr.city != blank %}, {{ addr.city }}{% endif %}{%- endcapture -%}
              <li data-cc-site-item data-search="{{ loc.name | append: ' ' | append: where | downcase | escape }}">
                {%- if loc.id == customer.current_location.id -%}
                  <span class="cc-site-picker__item is-current" aria-current="true">
                    {{- loc.name }} <small>{{ where }}</small> <em>(current)</em>
                  </span>
                {%- else -%}
                  <a class="cc-site-picker__item" href="{{ loc.url_to_set_as_current }}">
                    {{- loc.name }} <small>{{ where }}</small>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          <p class="cc-site-picker__empty" data-cc-site-empty hidden>No sites match your search.</p>
        </div>
      </div>
    {%- else -%}
      <p class="cc-trade-order__site">
        Delivering to <strong>{{ customer.current_location.name }}</strong>
        {%- if customer.current_company %} ({{ customer.current_company.name }}){% endif -%}
      </p>
    {%- endif -%}
    {%- if customer.current_location.metafields.b2b.closed.value == true -%}
      <p class="cc-trade-order__error">This delivery site has been closed. Please choose another site above, or contact Clearchoice.</p>
    {%- endif -%}
    {%- comment -%} Site budget for this month (filled in by trade-portal.js; hidden when the site has no budget). {%- endcomment -%}
    <div class="cc-budget" data-cc-budget hidden></div>
    <div data-cc-lines><p>Loading your prices…</p></div>
    {%- comment -%}
      Not a <form>: themes often wrap the cart page in their own cart <form>, and a nested form
      is dropped by the browser (and a submit button would send the theme's form to checkout).
    {%- endcomment -%}
    {%- comment -%} Quote for the buyer's approval / purchasing system (e.g. ApprovalMax Capture), valid 30 days. {%- endcomment -%}
    <div class="cc-trade-order__quote" data-cc-quote>
      <span class="cc-trade-order__quote-label">Need a quote for your purchase order?</span>
      <button type="button" class="cc-trade-order__quote-btn" data-cc-quote-format="pdf">Download quote (PDF)</button>
      <button type="button" class="cc-trade-order__quote-btn" data-cc-quote-format="csv">Quote lines (CSV)</button>
    </div>
    <div class="cc-trade-order__form" data-cc-form>
      {%- comment -%} Only the head-office admin can change this (shown once the app confirms who they are). {%- endcomment -%}
      <label class="cc-trade-order__no-po cc-trade-order__company-no-po" data-cc-company-no-po-wrap hidden>
        <input type="checkbox" data-cc-company-no-po {% if no_po %}checked{% endif %}>
        We don't use purchase orders <small>(applies to all our orders until unticked)</small>
      </label>
      {%- if no_po -%}
        <p class="cc-trade-order__po-help" data-cc-company-no-po-note>Your company doesn't use purchase orders (set by your head-office admin).</p>
      {%- endif -%}
      <label>
        <span data-cc-po-label>{% if no_po %}PO number (optional){% else %}PO number{% if block.settings.po_required %} *{% endif %}{% endif %}</span>
        <input type="text" data-cc-po maxlength="80" autocomplete="off" {% if block.settings.po_required %}aria-required="true"{% endif %}>
      </label>
      <label class="cc-trade-order__no-po" {% if no_po %}hidden{% endif %}>
        <input type="checkbox" data-cc-no-po>
        I don't have a PO number yet
      </label>
      <p class="cc-trade-order__po-help" data-cc-po-help hidden>Enter your first and last name. We'll send the order through and request the PO number from you.</p>
      <label>
        <span class="cc-trade-order__label-one-line">Delivery note (Phone Number / Delivery hours)</span>
        <textarea data-cc-note maxlength="500" rows="3"></textarea>
      </label>
      <p class="cc-trade-order__error" data-cc-error role="alert" hidden></p>
      <button type="button" class="cc-trade-order__submit" data-cc-submit disabled>Place order</button>
      <p class="cc-trade-order__terms">{{ block.settings.terms }}</p>
    </div>
    <div class="cc-trade-order__done" data-cc-done hidden></div>
  </div>
  <script src="{{ 'trade-portal.js' | asset_url }}" defer></script>
  {{ 'trade-portal.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Trade order",
  "target": "section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Place your trade order" },
    { "type": "checkbox", "id": "po_required", "label": "PO number required", "default": true },
    { "type": "text", "id": "terms", "label": "Note under the button", "default": "Prices are ex GST. Your order is charged to your account and invoiced on your usual terms." }
  ]
}
{% endschema %}
