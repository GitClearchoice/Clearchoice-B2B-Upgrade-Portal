{%- comment -%}
  Cart page: trade prices for every line, PO number, delivery note and "Place order".
  The order goes to the app (/apps/b2b/orders), which prices it again on the server.
{%- endcomment -%}
{%- if customer and customer.b2b? -%}
  <div
    class="cc-trade-order"
    data-cc-trade-order
    data-proxy="/apps/b2b"
    data-location="{{ customer.current_location.id }}"
    data-po-required="{{ block.settings.po_required }}"
    {{ block.shopify_attributes }}
  >
    <h2 class="cc-trade-order__heading">{{ block.settings.heading }}</h2>
    {%- if customer.company_available_locations_count > 1 -%}
      {%- comment -%}
        Buyers who look after several sites pick the delivery site here (with a search box when
        there are many). Shopify's own url_to_set_as_current switches the buyer's current
        location; the page then reloads and the cart is priced again for that site.
      {%- endcomment -%}
      <div class="cc-site-picker" data-cc-site-picker>
        <div class="cc-site-picker__label">Delivering to</div>
        <button type="button" class="cc-site-picker__current" data-cc-site-toggle aria-expanded="false">
          <strong>{{ customer.current_location.name }}</strong>
          <span class="cc-site-picker__change">Change site</span>
        </button>
        <div class="cc-site-picker__panel" data-cc-site-panel hidden>
          {%- if customer.company_available_locations_count > 5 -%}
            <input
              type="search"
              class="cc-site-picker__search"
              placeholder="Search {{ customer.company_available_locations_count }} sites by name or suburb"
              aria-label="Search sites"
              autocomplete="off"
              data-cc-site-search
            >
          {%- endif -%}
          <ul class="cc-site-picker__list" data-cc-site-list>
            {%- for loc in customer.company_available_locations -%}
              {%- assign addr = loc.shipping_address -%}
              {%- capture where -%}{{ addr.address1 }}{% if addr.city != blank %}, {{ addr.city }}{% endif %}{%- endcapture -%}
              <li data-cc-site-item data-search="{{ loc.name | append: ' ' | append: where | downcase | escape }}">
                {%- if loc.id == customer.current_location.id -%}
                  <span class="cc-site-picker__item is-current" aria-current="true">
                    {{- loc.name }} <small>{{ where }}</small> <em>(current)</em>
                  </span>
                {%- else -%}
                  <a class="cc-site-picker__item" href="{{ loc.url_to_set_as_current }}">
                    {{- loc.name }} <small>{{ where }}</small>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          <p class="cc-site-picker__empty" data-cc-site-empty hidden>No sites match your search.</p>
        </div>
      </div>
    {%- else -%}
      <p class="cc-trade-order__site">
        Delivering to <strong>{{ customer.current_location.name }}</strong>
        {%- if customer.current_company %} ({{ customer.current_company.name }}){% endif -%}
      </p>
    {%- endif -%}
    <div data-cc-lines><p>Loading your prices…</p></div>
    <form class="cc-trade-order__form" data-cc-form novalidate>
      <label>
        PO number{% if block.settings.po_required %} *{% endif %}
        <input type="text" name="poNumber" maxlength="100" autocomplete="off" {% if block.settings.po_required %}required{% endif %}>
      </label>
      <label>
        Delivery note (optional)
        <textarea name="note" maxlength="500" rows="3"></textarea>
      </label>
      <p class="cc-trade-order__error" data-cc-error role="alert" hidden></p>
      <button type="submit" class="button button--primary" data-cc-submit disabled>Place order</button>
      <p class="cc-trade-order__terms">{{ block.settings.terms }}</p>
    </form>
    <div class="cc-trade-order__done" data-cc-done hidden></div>
  </div>
  <script src="{{ 'trade-portal.js' | asset_url }}" defer></script>
  {{ 'trade-portal.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Trade order",
  "target": "section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Place your trade order" },
    { "type": "checkbox", "id": "po_required", "label": "PO number required", "default": true },
    { "type": "text", "id": "terms", "label": "Note under the button", "default": "Prices are ex GST. Your order is charged to your account and invoiced on your usual terms." }
  ]
}
{% endschema %}
