{%- comment -%}
  Product page: the logged-in trade buyer's price for the selected variant and quantity,
  worked out by the app (/apps/b2b/prices). Renders nothing for retail customers.
{%- endcomment -%}
{%- if customer and customer.b2b? -%}
  <div
    class="cc-trade-price"
    data-cc-trade-price
    data-proxy="/apps/b2b"
    data-location="{{ customer.current_location.id }}"
    data-default-variant="{{ product.selected_or_first_available_variant.id }}"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-cc-variants>
      [{%- for v in product.variants -%}{"id":{{ v.id }},"sku":{{ v.sku | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    </script>
    <div class="cc-trade-price__label">{{ block.settings.label }}</div>
    <div class="cc-trade-price__value" data-cc-value aria-live="polite">…</div>
    <div class="cc-trade-price__site">{{ customer.current_location.name }}</div>
  </div>
  <script src="{{ 'trade-portal.js' | asset_url }}" defer></script>
  {{ 'trade-portal.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Trade price",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Your trade price" }
  ]
}
{% endschema %}
