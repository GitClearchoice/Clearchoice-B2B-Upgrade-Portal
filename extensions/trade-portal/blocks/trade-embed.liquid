{%- comment -%}
  App embed: for trade buyers, hides the theme's own checkout and express-checkout buttons
  (trade orders go through "Place order") and, optionally, the theme's retail prices so only
  the trade price (Trade price / Trade order blocks) shows. Locations are also set to submit orders as drafts,
  as a safety net if a buyer reaches checkout anyway.
{%- endcomment -%}
{%- if customer and customer.b2b? -%}
  <style>
    {%- if block.settings.hide_checkout -%}
    form[action*="/cart"] [name="checkout"],
    form[action*="/cart"] button[type="submit"][name="checkout"],
    a[href*="/checkout"],
    .shopify-payment-button,
    .additional-checkout-buttons,
    shopify-accelerated-checkout,
    shopify-accelerated-checkout-cart { display: none !important; }
    {%- endif -%}
    {%- if block.settings.hide_theme_prices and block.settings.price_selector != blank -%}
    {{ block.settings.price_selector }} { display: none !important; }
    {%- endif -%}
  </style>
  <script>document.documentElement.classList.add("cc-trade-buyer");</script>
  {%- if block.settings.hide_theme_prices and block.settings.price_selector != blank -%}
    {%- comment -%} Trade prices on product cards (recently viewed, collections, search). {%- endcomment -%}
    <div
      hidden
      data-cc-card-prices
      data-proxy="/apps/b2b"
      data-location="{{ customer.current_location.id }}"
      data-selector="{{ block.settings.price_selector | escape }}"
    ></div>
    <script src="{{ 'trade-portal.js' | asset_url }}" defer></script>
    {{ 'trade-portal.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Trade portal",
  "target": "body",
  "settings": [
    { "type": "checkbox", "id": "hide_checkout", "label": "Hide checkout buttons for trade buyers", "default": true },
    { "type": "checkbox", "id": "hide_theme_prices", "label": "Hide the theme's retail prices for trade buyers", "default": true },
    {
      "type": "text",
      "id": "price_selector",
      "label": "Theme price elements to hide (CSS selector)",
      "info": "Change this if your theme still shows retail prices to trade buyers.",
      "default": ".price, product-price, .product__price, .product-price, [data-product-price]"
    }
  ]
}
{% endschema %}
